{
  "name": "arcade-framework",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/games/*",
    "packages/edge",
    "packages/app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @arcade/app",
    "dev:server": "npm run dev --workspace @arcade/edge",
    "build": "tsc -b && npm run build --workspace @arcade/app",
    "deploy:server": "npm run deploy --workspace @arcade/edge",
    "board": "node scripts/board.mjs",
    "typecheck": "tsc -b && tsc -p tests/tsconfig.json && tsc -p packages/edge/test/tsconfig.json",
    "test": "vitest run",
    "preview": "npm run preview --workspace @arcade/app"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
